# SpecLens AI - local development environment (placeholders only; never commit real secrets)

# Application
SPECLENS_ENV=local
SPECLENS_LOG_LEVEL=INFO
SPECLENS_API_HOST=0.0.0.0
SPECLENS_API_PORT=8000
SPECLENS_DEPLOYMENT_MODE=local

# Postgres
POSTGRES_USER=speclens
POSTGRES_PASSWORD=speclens_dev_password
POSTGRES_DB=speclens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://speclens:speclens_dev_password@postgres:5432/speclens

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local filesystem object storage (Phase 1 stub)
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_ROOT=/data/storage
MAX_UPLOAD_BYTES=52428800

# LLM provider key (optional; leave empty for stub backends)
# For Gemini free tier (Google AI Studio): paste the key here — never commit real keys.
OPENAI_API_KEY=
# Gemini OpenAI-compatible base (no trailing slash required):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Native OpenAI Responses API: leave unset (defaults to https://api.openai.com/v1)
OPENAI_BASE_URL=

# Embeddings / search (Phase 3)
# stub = local hash embedder (now Unicode/Hebrew-aware). For stronger multilingual
# retrieval with the fixed Vector(256) schema, use OpenAI text-embedding-3-small
# and keep EMBEDDING_DIMS=256 (API truncates dimensions):
#   EMBEDDING_BACKEND=openai
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMS=256
#   EMBEDDING_SEND_DIMENSIONS=true
#   OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_BACKEND=stub
EMBEDDING_MODEL=speclens-stub-v1
EMBEDDING_DIMS=256
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_BATCH_SIZE=64
SEARCH_VECTOR_LIMIT=30
SEARCH_LEXICAL_LIMIT=30
SEARCH_RRF_K=60
SEARCH_RESULT_LIMIT=12
SEARCH_RERANK_ENABLED=false
# Postgres FTS config (simple = multilingual / Hebrew-friendly)
SEARCH_FTS_CONFIG=simple

# Cited QA / generation (Phase 4; stub default for local/CI)
# stub | openai (Responses API) | openai_compat (Chat Completions — Gemini/Ollama/etc.)
GENERATION_BACKEND=stub
GENERATION_MODEL=speclens-stub-qa-v1
# Gemini example (after setting OPENAI_API_KEY + OPENAI_BASE_URL above):
# GENERATION_BACKEND=openai_compat
# GENERATION_MODEL=gemini-3.8-flash
ANSWERING_PROMPT_VERSION=answering-v1
QA_CONTEXT_TOKEN_BUDGET=1800
QA_MIN_RRF_SCORE=0.01
QA_MAX_CONTEXT_CHUNKS=8

# Requirement extraction (Phase 5; stub default for local/CI)
# stub understands EN + HE modals. For Gemini extraction reuse openai_compat:
#   EXTRACTION_BACKEND=openai_compat
#   EXTRACTION_MODEL=gemini-3.8-flash
EXTRACTION_BACKEND=stub
EXTRACTION_MODEL=speclens-stub-extract-v1
EXTRACTION_PROMPT_VERSION=extraction-v1

# Security / auth (Phase 8+)
# Local/CI: `make up` / `python -m app.cli bootstrap-local` activates the documented
# local key (hashed at rest). Use: Authorization: Bearer speclens-local-dev-key
# Production/hosted: NEVER run bootstrap-local. Create keys with:
#   python -m app.cli keys create --email you@example.com --name prod
# Hosted mode refuses speclens_dev_password, AUTH_REQUIRED=false, and an active local key.
AUTH_REQUIRED=true
RATE_LIMIT_PER_MINUTE=120
RETENTION_DAYS=365
# Destructive retention sweeps are off by default (local/dev safe).
RETENTION_SWEEP_ENABLED=false

# Required tooling versions (documented for developers)
# Python >= 3.12
# Node.js >= 22

# Browser SPA origins (React + Vite / prod web)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8001,http://localhost:8001

# Optional error tracking (API/worker); leave empty locally
SENTRY_DSN=

