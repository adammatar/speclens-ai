# SpecLens AI - local development environment (placeholders only; never commit real secrets)

# Application
SPECLENS_ENV=local
SPECLENS_LOG_LEVEL=INFO
SPECLENS_API_HOST=0.0.0.0
SPECLENS_API_PORT=8000
SPECLENS_DEPLOYMENT_MODE=local

# Postgres
POSTGRES_USER=speclens
POSTGRES_PASSWORD=speclens_dev_password
POSTGRES_DB=speclens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://speclens:speclens_dev_password@postgres:5432/speclens

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local filesystem object storage (Phase 1 stub)
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_ROOT=/data/storage
MAX_UPLOAD_BYTES=52428800

# OpenAI (optional; leave empty - Phase 3 defaults to stub embeddings)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Embeddings / search (Phase 3)
EMBEDDING_BACKEND=stub
EMBEDDING_MODEL=speclens-stub-v1
EMBEDDING_DIMS=256
EMBEDDING_BATCH_SIZE=64
SEARCH_VECTOR_LIMIT=30
SEARCH_LEXICAL_LIMIT=30
SEARCH_RRF_K=60
SEARCH_RESULT_LIMIT=12
SEARCH_RERANK_ENABLED=false

# Cited QA / generation (Phase 4; stub default for local/CI)
GENERATION_BACKEND=stub
GENERATION_MODEL=speclens-stub-qa-v1
ANSWERING_PROMPT_VERSION=answering-v1
QA_CONTEXT_TOKEN_BUDGET=1800
QA_MIN_RRF_SCORE=0.01
QA_MAX_CONTEXT_CHUNKS=8

# Requirement extraction (Phase 5; stub default for local/CI)
EXTRACTION_BACKEND=stub
EXTRACTION_MODEL=speclens-stub-extract-v1
EXTRACTION_PROMPT_VERSION=extraction-v1

# Security / auth (Phase 8)
# Local/CI bootstrap API key is seeded by migration 20261108_0007 (SHA-256 hashed at rest).
# Use: Authorization: Bearer speclens-local-dev-key   or   X-API-Key: speclens-local-dev-key
# Never commit a production secret here - rotate/replace before any hosted deploy.
AUTH_REQUIRED=true
RATE_LIMIT_PER_MINUTE=120
RETENTION_DAYS=365

# Required tooling versions (documented for developers)
# Python >= 3.12
# Node.js >= 22

# Browser SPA origins (React + Vite / prod web)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080

# Optional error tracking (API/worker); leave empty locally
SENTRY_DSN=

