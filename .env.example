# SpecLens AI - local development environment (placeholders only; never commit real secrets)

# Application
SPECLENS_ENV=local
SPECLENS_LOG_LEVEL=INFO
SPECLENS_API_HOST=0.0.0.0
SPECLENS_API_PORT=8000
SPECLENS_DEPLOYMENT_MODE=local

# Postgres
POSTGRES_USER=speclens
POSTGRES_PASSWORD=speclens_dev_password
POSTGRES_DB=speclens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://speclens:speclens_dev_password@postgres:5432/speclens

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Local filesystem object storage (Phase 1 stub)
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_ROOT=/data/storage
MAX_UPLOAD_BYTES=52428800

# OpenAI (Phase 2+; leave empty for Phase 1)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Required tooling versions (documented for developers)
# Python >= 3.12
# Node.js >= 22
